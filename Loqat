<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فلش‌کارت‌های زبان من</title>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; background: #f0f4f8; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; margin: 0; padding: 20px; box-sizing: border-box; }
        .card-container { perspective: 1000px; width: 100%; max-width: 350px; height: 420px; }
        .card { width: 100%; height: 100%; position: relative; transition: transform 0.6s; transform-style: preserve-3d; cursor: pointer; }
        .card.flipped { transform: rotateY(-180deg); }
        .card-face { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; background: white; border-radius: 16px; box-shadow: 0 8px 20px rgba(0,0,0,0.1); padding: 25px; box-sizing: border-box; display: flex; flex-direction: column; }
        .card-front { align-items: center; justify-content: center; background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); }
        .card-back { transform: rotateY(180deg); overflow-y: auto; text-align: left; direction: ltr; }
        .word-title { font-size: 2.5rem; color: #2563eb; font-weight: bold; text-align: center; margin: 0; }
        .hint { color: #64748b; margin-top: 20px; font-size: 1rem; text-align: center; }
        .section-title { font-size: 0.9rem; color: #64748b; margin-top: 15px; border-bottom: 2px solid #e2e8f0; padding-bottom: 5px; font-weight: bold; text-transform: uppercase; }
        .items { color: #0f172a; margin-top: 5px; font-size: 1.1rem; font-weight: 500; }
        .sentence { margin-top: 12px; font-size: 1rem; line-height: 1.5; color: #1e293b; display: flex; gap: 10px; align-items: flex-start; }
        .level { font-size: 0.75rem; background: #e2e8f0; padding: 3px 8px; border-radius: 6px; font-weight: bold; color: #475569; white-space: nowrap; }
        .next-btn { margin-top: 25px; padding: 15px 20px; background: #2563eb; color: white; border: none; border-radius: 12px; font-size: 1.2rem; font-weight: bold; cursor: pointer; width: 100%; max-width: 350px; box-shadow: 0 4px 10px rgba(37,99,235,0.3); transition: 0.2s; }
        .next-btn:active { background: #1d4ed8; transform: scale(0.98); }
    </style>
</head>
<body>

    <div class="card-container" onclick="flipCard()">
        <div class="card" id="flashcard">
            <!-- روی کارت -->
            <div class="card-face card-front">
                <h1 class="word-title" id="front-word">Word</h1>
                <div class="hint">برای دیدن معنی و جملات، روی کارت بزن 👆</div>
            </div>
            <!-- پشت کارت -->
            <div class="card-face card-back">
                <h2 class="word-title" id="back-word" style="font-size: 2rem; margin-bottom: 10px;">Word</h2>
                
                <div class="section-title">Synonyms (مترادف‌ها)</div>
                <div class="items" id="synonyms"></div>

                <div class="section-title">Antonyms (متضادها)</div>
                <div class="items" id="antonyms"></div>

                <div class="section-title">Sentences (جملات)</div>
                <div id="sentences"></div>
            </div>
        </div>
    </div>

    <button class="next-btn" onclick="nextWord()">کلمه بعدی ➡️</button>

    <script>
        // بانک کلمات شما - می‌تونی بعداً هر چقدر خواستی به این لیست اضافه کنی
        const vocabList = [
            {
                word: "Important",
                synonyms: "Crucial, Essential",
                antonyms: "Unimportant, Trivial",
                sentences: [
                    { text: "This is important.", level: "L1" },
                    { text: "It is important to practice every day.", level: "L2" },
                    { text: "Learning English is an important skill for my future.", level: "L3" }
                ]
            },
            {
                word: "Fast",
                synonyms: "Quick, Rapid",
                antonyms: "Slow",
                sentences: [
                    { text: "The car is fast.", level: "L1" },
                    { text: "He speaks very fast.", level: "L2" },
                    { text: "You need to be fast to catch the early bus.", level: "L3" }
                ]
            },
            {
                word: "Speak",
                synonyms: "Talk, Say",
                antonyms: "Listen, Be quiet",
                sentences: [
                    { text: "I speak English.", level: "L1" },
                    { text: "Can you speak more slowly, please?", level: "L2" },
                    { text: "We spoke about our plans for the weekend.", level: "L3" }
                ]
            }
        ];

        let currentIndex = 0;
        const card = document.getElementById('flashcard');

        function loadWord() {
            const current = vocabList[currentIndex];
            
            // پر کردن روی کارت
            document.getElementById('front-word').textContent = current.word;
            
            // پر کردن پشت کارت
            document.getElementById('back-word').textContent = current.word;
            document.getElementById('synonyms').textContent = current.synonyms;
            document.getElementById('antonyms').textContent = current.antonyms;
            
            const sentencesDiv = document.getElementById('sentences');
            sentencesDiv.innerHTML = '';
            current.sentences.forEach(s => {
                const div = document.createElement('div');
                div.className = 'sentence';
                div.innerHTML = `<span class="level">${s.level}</span> <span>${s.text}</span>`;
                sentencesDiv.appendChild(div);
            });
        }

        function flipCard() {
            card.classList.toggle('flipped');
        }

        function nextWord() {
            currentIndex = (currentIndex + 1) % vocabList.length;
            card.classList.remove('flipped');
            // یه مکث کوتاه تا کارت برگرده بعد کلمه عوض بشه
            setTimeout(loadWord, 200); 
        }

        // اجرای اولیه
        loadWord();
    </script>
</body>
</html>
